{:paths ["src" "resources"]
 :deps {babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        org.babashka/cli {:mvn/version "0.12.91"}}
 :bbin/bin {bb-build {:main-opts ["-m" "bb-build.cli.main"]}}
 :tasks
 {ci:sync {:doc "Render the managed CI workflows into a repo. Prints a diff; writes only with --write."
           :requires ([bb-build.ci :as ci])
           :task (ci/sync-task *command-line-args*)}
  ci:drift {:doc "Fail when a repo's managed workflows differ from their templates, or pin an old action major."
            :requires ([bb-build.ci :as ci])
            :task (ci/drift-task *command-line-args*)}
  test {:extra-paths ["test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                     io.github.cognitect-labs/test-runner
                     {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
        :task (exec 'cognitect.test-runner.api/test)}}}
