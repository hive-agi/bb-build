  ;; :build — canonical hive release entrypoint (clojure -T:build <task>).
  ;; Consumes the published hive-build.api: clean / jar / jar-aot / install /
  ;; bump / verify-license / kondo / deploy. No per-repo build script.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.0"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}
